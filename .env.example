# Copie para .env (que NÃO vai para o git) e preencha os valores.
# Lido pelo docker compose (database/docker-compose.yml) e pela aplicação.

# --- Banco de dados (Postgres no Docker) ---
POSTGRES_DB=demosdd
POSTGRES_USER=demosdd
POSTGRES_PASSWORD=demosdd

# --- E-mail (SMTP do Gmail) ---
# MAIL_USERNAME: seu endereço Gmail
# MAIL_PASSWORD: senha de app de 16 caracteres (https://myaccount.google.com/apppasswords),
#                não a senha normal da conta
MAIL_USERNAME=seu.email@gmail.com
MAIL_PASSWORD=
# Remetente exibido no e-mail (opcional; padrão = MAIL_USERNAME)
# MAIL_FROM=seu.email@gmail.com

# --- Aplicação ---
# URL usada para montar o link de ativação enviado por e-mail
APP_BASE_URL=http://localhost:8080
# Cookie de sessão só por HTTPS (padrão false, porque a execução local é em http)
# SESSION_COOKIE_SECURE=true
